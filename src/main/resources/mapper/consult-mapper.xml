<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!-- 해당 파일에 모든 쿼리문을 작성 -->
<!-- namespace에는 xml파일과 연결할 Mapper interface 파일명을 패키지를 포함하여 적어주세요 -->
<mapper namespace="com.green.lms.consult.mapper.ConsultMapper">
  <resultMap id="consultMap" type="com.green.lms.consult.vo.ConsultVO">
    <id     column="CONSULT_NUM"      property="consultNum"/>
    <result column="STU_NUM"          property="stuNum"/>
    <result column="MANAGER_NUM"      property="managerNum"/>
    <result column="CONSULT_CONTENT"  property="consultContent"/>
    <result column="CLASS_NUM"        property="classNum"/>
    <result column="CONSULT_STATUS"   property="consultStatus"/>
    <result column="CONSULT_TYPE"     property="consultType"/>
    <result column="SUPPORT_TYPE"     property="supportType"/>
    <result column="HRD_STATUS"       property="hrdStatus"/>
    <result column="CONSULT_GRADE"    property="consultGrade"/>
    <result column="CUSTOM_ROWS"      property="customRows"/>
    <result column="ATTITUDE_SCORE"   property="attitudeScore"/>
    <result column="ATTENDANCE_SCORE" property="attendanceScore"/>
    <result column="MIND_SCORE"       property="mindScore"/>
    <result column="JOB_SCORE"        property="jobScore"/>
    <result column="TOTAL_SCORE"      property="totalScore"/>
    <result column="CREATE_USER"      property="createUser"/>
    <result column="UPDATE_USER"      property="updateUser"/>
    <result column="CREATE_DATE"      property="createDate"/>
    <result column="UPDATE_DATE"      property="updateDate"/>

    <association property="stuVO"       resultMap="com.green.lms.stu.mapper.StuMapper.stuMap" />
    <association property="staffVO"     resultMap="com.green.lms.staff.mapper.StaffMapper.staffMap" column="MANAGER_NUM"/>
    <association property="classInfoVO" resultMap="com.green.lms.cls.mapper.ClassMapper.classInfoMap" />
  </resultMap>

  <insert id="insertConsult">
    INSERT INTO CONSULT_INFO (
      STU_NUM
      , MANAGER_NUM
      , CLASS_NUM
      , CREATE_USER
    )
    SELECT
      #{stuNum}
      , #{managerNum}
      , #{classNum}
      , 'admin'
  </insert>

  <!--학생 등록 시 상담 이력 조회-->
  <select id="selectConsultHistory" resultMap="consultMap">
    SELECT CONSULT_NUM
      , CI.STU_NUM
      , STU_NAME
      , STU_BIRTHDAY
      , STU_PHONE
      , CI.CLASS_NUM
      , CLASS_NAME
      , START_DATE
      , END_DATE
      , MANAGER_NUM
      , STAFF_NAME
      , CONSULT_CONTENT
    FROM CONSULT_INFO CI INNER JOIN stu_info SI
    ON CI.STU_NUM = SI.STU_NUM
    INNER JOIN class_info CLS
    ON CI.CLASS_NUM = CLS.CLASS_NUM
    INNER JOIN staff_info STAFF
    ON CI.MANAGER_NUM = STAFF.STAFF_NUM
    WHERE CI.STU_NUM = #{stuNum}
  </select>

  <!--동일 학생이 한 과정에 중복 상담 체크인지 확인-->
  <select id="checkDuplicateConsult" resultType="String">
    SELECT 'Y'
    FROM CONSULT_INFO
    WHERE STU_NUM = #{stuNum}
    AND CLASS_NUM = #{classNum}
  </select>

</mapper>
































